    const categorySelect = document.getElementById("category");
    const categories = ["All Grammar", ...new Set(BANK.map(q=>q.category))];
    categories.forEach(c=>{
      const opt=document.createElement("option");
      opt.value=c; opt.textContent=c;
      categorySelect.appendChild(opt);
    });

    let session = {
      questions:[], index:0, score:0, streak:0, answered:0, checked:false,
      max:null, timer:null, timeLeft:0, mode:"endless", current:null, missed:[]
    };

    const els = {
      setup:document.getElementById("setup"), game:document.getElementById("game"), summary:document.getElementById("summary"),
      startBtn:document.getElementById("startBtn"), resetBestBtn:document.getElementById("resetBestBtn"),
      mode:document.getElementById("mode"), catBadge:document.getElementById("catBadge"), timer:document.getElementById("timer"),
      score:document.getElementById("score"), streak:document.getElementById("streak"), best:document.getElementById("best"),
      count:document.getElementById("count"), progress:document.getElementById("progress"), progressText:document.getElementById("progressText"),
      questionText:document.getElementById("questionText"), answerArea:document.getElementById("answerArea"),
      feedback:document.getElementById("feedback"), submitBtn:document.getElementById("submitBtn"), nextBtn:document.getElementById("nextBtn"),
      stopBtn:document.getElementById("stopBtn"), summaryText:document.getElementById("summaryText"), missedBox:document.getElementById("missedBox"),
      againBtn:document.getElementById("againBtn"), homeBtn:document.getElementById("homeBtn")
    };

    function shuffle(arr){
      return [...arr].sort(()=>Math.random()-0.5);
    }

    function bestKey(){
      return "engl111MidBest_" + categorySelect.value;
    }

    function getBest(){
      return Number(localStorage.getItem(bestKey()) || 0);
    }

    function setBest(score){
      if(score > getBest()) localStorage.setItem(bestKey(), String(score));
    }

    function normalize(s){
      return String(s).trim().toLowerCase().replace(/[’']/g,"'").replace(/\s+/g," ");
    }

    function isCorrect(user, answer){
      return normalize(user) === normalize(answer);
    }

    function start(){
      const cat = categorySelect.value;
      let pool = cat === "All Grammar" ? BANK : BANK.filter(q=>q.category === cat);
      pool = shuffle(pool);
      const mode = els.mode.value;
      const max = mode === "ten" ? 10 : mode === "twenty" ? 20 : null;
      session = {questions:pool, index:0, score:0, streak:0, answered:0, checked:false, max, timer:null, timeLeft: mode==="ten" ? 300 : 0, mode, current:null, missed:[]};
      els.setup.classList.add("hidden");
      els.summary.classList.add("hidden");
      els.game.classList.remove("hidden");
      els.best.textContent = getBest();
      if(mode === "ten") startTimer();
      renderQuestion();
    }

    function startTimer(){
      clearInterval(session.timer);
      session.timer = setInterval(()=>{
        session.timeLeft--;
        updateStats();
        if(session.timeLeft <= 0) finish("Time is up.");
      },1000);
    }

    function formatTime(sec){
      const m = Math.floor(sec/60);
      const s = sec%60;
      return `${m}:${String(s).padStart(2,"0")}`;
    }

    function updateStats(){
      els.score.textContent = session.score;
      els.streak.textContent = session.streak;
      els.best.textContent = Math.max(getBest(), session.score);
      els.count.textContent = session.answered;
      els.timer.textContent = session.mode === "ten" ? `Time: ${formatTime(session.timeLeft)}` : "";
      const max = session.max;
      if(max){
        const pct = Math.min(100, (session.answered / max) * 100);
        els.progress.style.width = pct + "%";
        els.progressText.textContent = `${session.answered} of ${max} questions answered`;
      } else {
        els.progress.style.width = Math.min(100, (session.streak % 10) * 10) + "%";
        els.progressText.textContent = `Endless practice · Fill the bar by getting a streak of 10.`;
      }
    }

    function renderQuestion(){
      session.checked = false;
      els.feedback.className = "feedback";
      els.feedback.style.display = "none";
      els.nextBtn.classList.add("hidden");
      els.submitBtn.classList.remove("hidden");

      if(session.index >= session.questions.length){
        session.questions = shuffle(session.questions);
        session.index = 0;
      }
      session.current = session.questions[session.index++];
      const q = session.current;
      els.catBadge.textContent = q.category;
      els.questionText.textContent = q.prompt;
      els.answerArea.innerHTML = "";

      if(q.type === "mcq"){
        const wrap = document.createElement("div");
        wrap.className = "choices";
        shuffle(q.choices).forEach(choice=>{
          const btn = document.createElement("button");
          btn.className = "choice";
          btn.textContent = choice;
          btn.onclick = () => {
            [...wrap.children].forEach(b=>b.dataset.selected="false");
            btn.dataset.selected = "true";
            [...wrap.children].forEach(b=>b.style.borderColor="#ead5dd");
            btn.style.borderColor = "var(--garnet)";
          };
          wrap.appendChild(btn);
        });
        els.answerArea.appendChild(wrap);
      } else {
        const input = document.createElement("input");
        input.type = "text";
        input.id = "gapAnswer";
        input.placeholder = "Type your answer";
        input.autocomplete = "off";
        input.addEventListener("keydown", e=>{
          if(e.key === "Enter") checkAnswer();
        });
        els.answerArea.appendChild(input);
        setTimeout(()=>input.focus(),50);
      }
      updateStats();
    }

    function getUserAnswer(){
      const q = session.current;
      if(q.type === "mcq"){
        const selected = [...document.querySelectorAll(".choice")].find(b=>b.dataset.selected === "true");
        return selected ? selected.textContent : "";
      }
      const input = document.getElementById("gapAnswer");
      return input ? input.value : "";
    }

    function checkAnswer(){
      if(session.checked) return;
      const q = session.current;
      const user = getUserAnswer();
      if(!user){
        els.feedback.className = "feedback wrong";
        els.feedback.style.display = "block";
        els.feedback.innerHTML = "Choose an answer first.";
        return;
      }
      const ok = isCorrect(user, q.answer);
      session.checked = true;
      session.answered++;
      if(ok){
        session.score++;
        session.streak++;
        els.feedback.className = "feedback correct";
        els.feedback.innerHTML = "Correct!";
      } else {
        session.streak = 0;
        session.missed.push(q);
        els.feedback.className = "feedback wrong";
        els.feedback.innerHTML = `Not quite. Correct answer: <strong>${q.answer}</strong><div class="arabic">${q.explanation}</div>`;
      }
      els.feedback.style.display = "block";
      setBest(session.score);
      updateStats();

      if(session.max && session.answered >= session.max){
        els.submitBtn.classList.add("hidden");
        els.nextBtn.textContent = "See Summary";
        els.nextBtn.classList.remove("hidden");
        els.nextBtn.onclick = () => finish();
      } else {
        els.submitBtn.classList.add("hidden");
        els.nextBtn.textContent = "Next";
        els.nextBtn.classList.remove("hidden");
        els.nextBtn.onclick = renderQuestion;
      }
    }

    function finish(reason=""){
      clearInterval(session.timer);
      setBest(session.score);
      els.game.classList.add("hidden");
      els.summary.classList.remove("hidden");
      const total = session.answered || 0;
      const percent = total ? Math.round((session.score/total)*100) : 0;
      els.summaryText.innerHTML = `${reason ? reason + "<br>" : ""}<strong>Score:</strong> ${session.score}/${total} (${percent}%). <strong>Best score for this focus:</strong> ${getBest()}.`;

      if(session.missed.length){
        const unique = session.missed.slice(-6);
        els.missedBox.innerHTML = `<h3>Review these:</h3><ul class="review-list">${unique.map(q=>`<li>${q.prompt}<br><strong>Answer:</strong> ${q.answer}</li>`).join("")}</ul>`;
      } else {
        els.missedBox.innerHTML = `<p>Great work. No missed questions in this round.</p>`;
      }
    }

    els.startBtn.onclick = start;
    els.submitBtn.onclick = checkAnswer;
    els.stopBtn.onclick = () => finish("Practice stopped.");
    els.againBtn.onclick = start;
    els.homeBtn.onclick = () => {
      clearInterval(session.timer);
      els.summary.classList.add("hidden");
      els.game.classList.add("hidden");
      els.setup.classList.remove("hidden");
    };
    els.resetBestBtn.onclick = () => {
      localStorage.removeItem(bestKey());
      alert("Best score reset for this grammar focus.");
    };
  </script>
</body>
</html>
